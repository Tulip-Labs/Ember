# Maintainer: Tulip Labs <tulip-labs@users.noreply.github.com>
# Made by the release workflow from packaging/PKGBUILD.in (AUR: ember-shell-bin).
pkgname=ember-shell-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="A calm full-screen home for the niri compositor"
arch=('x86_64')
url="https://github.com/Tulip-Labs/Ember"
license=('GPL-3.0-only')
depends=('gtk4' 'libadwaita' 'glib2' 'gdk-pixbuf2')
optdepends=('niri: the window manager Ember is made for'
            'swaybg: Ember\'s Iris wallpaper on the desktop')
provides=('ember-shell')
conflicts=('ember-shell')
source=("Ember-linux-x86_64-${pkgver}.tar.gz::https://github.com/Tulip-Labs/Ember/releases/download/v${pkgver}/Ember-linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
	cd "Ember-linux-x86_64"
	install -Dm755 ember "$pkgdir/usr/lib/ember-shell/ember"
	echo arch > "$pkgdir/usr/lib/ember-shell/install-kind"
	install -d "$pkgdir/usr/bin"
	ln -s /usr/lib/ember-shell/ember "$pkgdir/usr/bin/ember"
	install -Dm644 README.md "$pkgdir/usr/share/doc/ember-shell/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
